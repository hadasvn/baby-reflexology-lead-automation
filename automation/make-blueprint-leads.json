{
  "name": "Leads — Landing Page Intake (Baby Reflexology)",
  "flow": [
    {
      "id": 1,
      "mapper": {},
      "module": "gateway:CustomWebHook",
      "version": 1,
      "metadata": {
        "designer": { "x": 0, "y": 0, "name": "Lead — Baby Reflexology" },
        "restore": {
          "parameters": {
            "hook": { "data": { "editable": "true" }, "label": "Lead — Baby Reflexology" }
          }
        },
        "parameters": [
          { "name": "hook", "type": "hook:gateway-webhook", "label": "Webhook", "required": true },
          { "name": "maxResults", "type": "number", "label": "Maximum number of results" }
        ]
      },
      "parameters": { "maxResults": 1 }
    },
    {
      "id": 2,
      "mapper": {
        "mode": "map",
        "spreadsheetId": "{{SPREADSHEET_ID}}",
        "sheetId": "לידים",
        "tableFirstRow": "A1:Z1",
        "insertUnformatted": false,
        "valueInputOption": "USER_ENTERED",
        "insertDataOption": "INSERT_ROWS",
        "values": {
          "B": "{{formatDate(now; \"YYYY-MM-DD HH:mm:ss\")}}",
          "C": "{{1.name}}",
          "D": "{{1.phone}}",
          "E": "{{1.email}}",
          "F": "ליד חדש"
        }
      },
      "module": "google-sheets:addRow",
      "version": 2,
      "metadata": {
        "designer": { "x": 300, "y": 0, "name": "רישום ליד חדש ב-Sheet" },
        "restore": {
          "parameters": { "__IMTCONN__": { "label": "Google account (owner's)" } }
        },
        "parameters": [
          { "name": "__IMTCONN__", "type": "account:google", "label": "Connection", "required": true }
        ]
      },
      "parameters": {}
    },
    {
      "id": 3,
      "mapper": {
        "mode": "map",
        "spreadsheetId": "{{SPREADSHEET_ID}}",
        "sheetId": "לידים",
        "rowNumber": "{{2.rowNumber}}",
        "tableFirstRow": "A1:Z1",
        "valueInputOption": "USER_ENTERED",
        "values": {
          "A": "{{2.rowNumber - 1}}"
        }
      },
      "module": "google-sheets:updateRow",
      "version": 2,
      "metadata": {
        "designer": { "x": 600, "y": -120, "name": "הקצאת מזהה רץ" },
        "restore": {
          "parameters": { "__IMTCONN__": { "label": "Google account (owner's)" } }
        },
        "parameters": [
          { "name": "__IMTCONN__", "type": "account:google", "label": "Connection", "required": true }
        ]
      },
      "parameters": {}
    },
    {
      "id": 4,
      "mapper": {
        "to": ["{{1.email}}"],
        "subject": "בייבי רפלקסולוגיה — תודה שהשארת פרטים",
        "bodyType": "collection",
        "contents": [
          { "text": "ראו templates/email-initial-lead.html בריפו הזה", "image": {} }
        ]
      },
      "module": "google-email:sendAnEmail",
      "version": 4,
      "metadata": {
        "designer": { "x": 900, "y": 0, "name": "מייל ראשוני ללקוח" },
        "restore": {
          "parameters": { "__IMTCONN__": { "label": "Google account (owner's)" } }
        },
        "parameters": [
          { "name": "__IMTCONN__", "type": "account:google-email", "label": "Connection", "required": true }
        ]
      },
      "parameters": {}
    },
    {
      "id": 5,
      "mapper": {
        "mode": "map",
        "spreadsheetId": "{{SPREADSHEET_ID}}",
        "sheetId": "לידים",
        "rowNumber": "{{2.rowNumber}}",
        "tableFirstRow": "A1:Z1",
        "valueInputOption": "USER_ENTERED",
        "values": {
          "F": "נשלח מייל ראשוני",
          "G": "{{formatDate(now; \"YYYY-MM-DD HH:mm:ss\")}}"
        }
      },
      "module": "google-sheets:updateRow",
      "version": 2,
      "metadata": {
        "designer": { "x": 1200, "y": 0, "name": "עדכון סטטוס: נשלח מייל" },
        "restore": {
          "parameters": { "__IMTCONN__": { "label": "Google account (owner's)" } }
        },
        "parameters": [
          { "name": "__IMTCONN__", "type": "account:google", "label": "Connection", "required": true }
        ]
      },
      "parameters": {}
    }
  ],
  "metadata": {
    "instant": true,
    "version": 1,
    "scenario": {
      "roundtrips": 1,
      "maxErrors": 3,
      "autoCommit": true,
      "autoCommitTriggerLast": true,
      "sequential": false,
      "confidential": false,
      "dataloss": false,
      "dlq": false,
      "freshVariables": false
    },
    "designer": { "orphans": [] },
    "zone": "eu2.make.com"
  }
}
